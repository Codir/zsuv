; Engine configuration file.
config_version=5

[application]

config/name="Khutir Road"
config/description="A PSX-style winter delivery drive down the road to a lone khutir."
config/version="0.3.0"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.23, 0.267, 0.349, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
textures/vram_compression/import_etc2_astc=true
